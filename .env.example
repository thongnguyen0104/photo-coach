# ============================================================
#  Mẫu biến môi trường. Copy thành .env.local rồi điền giá trị.
#  .env.local chứa bí mật → đã nằm trong .gitignore, KHÔNG commit.
#  Hướng dẫn lấy từng giá trị: docs/PHASE0-SETUP.md
#  Thiếu biến nào → khi chạy local, app tự dùng bản thay thế (xem README.md).
# ============================================================

# --- Neon Postgres (Bước 3) ---
# Dạng: postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Auth.js (Bước 7) ---
# Chuỗi ngẫu nhiên. Chạy `npm run check` trong tools/setup-check, nó sẽ in ra 1 chuỗi để copy.
AUTH_SECRET=

# --- Google OAuth (Bước 5) ---
# Client ID kết thúc bằng .apps.googleusercontent.com ; Secret bắt đầu bằng GOCSPX-
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Gemini (Bước 4) ---
GEMINI_API_KEY=
# "gemini-flash-latest" = bản Flash mới nhất, phân tích chính xác nhất.
# ⚠ Gói miễn phí giới hạn THEO TỪNG MODEL — đo được 10/2026: flash-latest chỉ 20 request/ngày.
#   Muốn nhiều lượt hơn: gemini-3.5-flash-lite (quota riêng, nhanh hơn nhưng kém chính xác hơn).
#   Xem hạn mức thật của bạn: https://ai.dev/rate-limit
GEMINI_MODEL=gemini-flash-latest

# --- Oracle Cloud Object Storage (Bước 6) ---
OCI_NAMESPACE=
# Mã region, ví dụ: ap-singapore-1
OCI_REGION=
OCI_BUCKET=photo-coach-uploads
# Customer Secret Key: "Access key" và "Secret key"
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# Để trống — tự tính từ NAMESPACE + REGION. Chỉ điền nếu cần ghi đè.
OCI_S3_ENDPOINT=

# --- App ---
# Số lượt phân tích / người / ngày (reset 0h giờ VN)
DAILY_QUOTA=10
# Số ảnh mới được tải lên / người / ngày (chặn spam). Để trống = gấp 3 DAILY_QUOTA
DAILY_UPLOAD_LIMIT=

# Tính năng xoá vật thể trong trình chỉnh sửa ảnh (model MI-GAN ~28MB chạy trên trình duyệt người dùng).
# Mặc định TẮT. Điền 1 để bật.
ENABLE_OBJECT_REMOVAL=

# --- Tuỳ chọn khi chạy local (bỏ dấu # để bật) ---
# AI_PROVIDER=mock        # dùng AI giả lập, không tốn quota Gemini
# STORAGE_DRIVER=local    # lưu ảnh trên máy (.data/storage) dù đã cấu hình Oracle
# AUTH_DEV_LOGIN=0        # tắt nút "Đăng nhập thử" (nút này luôn tắt trên production)
